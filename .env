# =============================================================================
# Ports for running the project locally. Change them here and nowhere else.
# (No secrets in this file: it only holds local settings.)
# =============================================================================

# Docker: all demos at http://localhost:<DOCKER_PORT>/ and http://<slug>.localhost:<DOCKER_PORT>/
# After changing it run:  docker compose up -d
DOCKER_PORT=8080

# Python preview of one demo:  python new_demo.py --serve <slug>  ->  http://localhost:<SERVE_PORT>/
SERVE_PORT=8000
