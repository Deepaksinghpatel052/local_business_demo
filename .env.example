# =============================================================================
# Copy to .env and fill in. .env is never committed (see .gitignore).
# Every setting of the project lives here: change a value here and nowhere else.
# Used by docker compose, python new_demo.py and the Django site builder (builder/).
# Keep comments on their own lines: "KEY=value # note" would put the note in the value.
# After a change: docker compose up -d   (or: docker restart local-business-builder)
# =============================================================================

# --- Ports -----------------------------------------------------------------------
# Docker: the site builder at http://127.0.0.1:<APP_DOCKER_PORT>/ (only this computer; the server's
# Nginx proxies to it). Keep APP_URL below in step on your computer.
APP_DOCKER_PORT=9002
# Docker, DEBUG=False: number of Gunicorn workers (2 x CPU cores + 1 is a good start)
GUNICORN_WORKERS=3
# Python preview of one demo:  python new_demo.py --serve <slug>  ->  http://localhost:<SERVE_PORT>/
SERVE_PORT=8001

# --- Django core -----------------------------------------------------------------
# False on the server
DEBUG=True
# New key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
# Comma separated. Server: app.devnixplus.com
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma separated. Server: https://app.devnixplus.com
CSRF_TRUSTED_ORIGINS=
# Empty = SQLite in builder/db.sqlite3. Server (PostgreSQL): postgres://devnix:PASSWORD@127.0.0.1:5432/devnix
DATABASE_URL=
# Server with several Gunicorn workers (shared rate limits): filecache:///var/tmp/devnix-cache
CACHE_URL=locmemcache://
# True on the server (HTTPS-only cookies)
SECURE_COOKIES=False
# Nginx already redirects http -> https, so False everywhere
SECURE_SSL_REDIRECT=False
# 0 locally. Server: 31536000 (one year)
SECURE_HSTS_SECONDS=0

# --- URLs ------------------------------------------------------------------------
# The site builder's address. Docker: http://localhost:<APP_DOCKER_PORT>. Server: https://app.devnixplus.com
# Also used by the showcase "Use this design" buttons (manage.py write_showcase_config).
APP_URL=http://localhost:9002
# path      -> <DEMO_BASE_URL>/<slug>/
# subdomain -> <DEMO_SCHEME>://<slug>.<DEMO_DOMAIN>/
DEMO_URL_STYLE=path
# Docker: <APP_URL>/sites. Server: https://demo.devnixplus.com
DEMO_BASE_URL=http://localhost:9002/sites
DEMO_DOMAIN=demo.devnixplus.com
DEMO_SCHEME=https
# Bump (v2, v3...) after changing template/, then run sync_shared and republish_all
SHARED_VERSION=v1
# True = Django serves /sites/, /_shared/, /media/ and /static/ itself (a computer without Nginx).
# False on the server: its Nginx serves those folders directly.
SERVE_FILES=True

# --- Client files (photos people upload, published websites) -------------------------
# MEDIA_DIR = the folder on this computer/server that holds every client file. Docker mounts it at
# /app/media, so restarting or rebuilding the container never loses client data. Default: the
# project's media/ folder. It can be anywhere, e.g. /srv/devnix-media (back it up!).
#   <MEDIA_DIR>/uploads/   photos owners upload         (Nginx: /media/)
#   <MEDIA_DIR>/sites/     published websites + _shared  (Nginx: demo.devnixplus.com, customer domains)
MEDIA_DIR=./media
# The same folders for Django run without Docker (relative = from the project folder).
# Inside Docker they are always /app/media/uploads and /app/media/sites (docker-compose.yml).
MEDIA_ROOT=media/uploads
SITES_ROOT=media/sites
# The sites folder as the server's Nginx sees it, for the customer-domain blocks generated in /manage/.
# Server: the absolute path of <MEDIA_DIR>/sites, e.g. /srv/local_business_demo/media/sites
NGINX_SITES_ROOT=

# --- Other folders (relative = from the project folder; mounted with the code in Docker) ----
# collectstatic output (the server's Nginx serves it at /static/)
STATIC_ROOT=var/static
LOG_DIR=var/logs

# --- Login with Google (optional; the button only shows when set) -------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorised redirect URI: <APP_URL>/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Coming soon page until launch -----------------------------------------------
# Before this date and time every public page shows /coming-soon/ (team members see the real site).
# Leave empty after launch. Format: 2026-11-08T00:00:00+05:30
LAUNCH_AT=2026-11-08T00:00:00+05:30
# The first N early sign-ups get a free website (the page shows the real number left)
EARLY_OFFER_SPOTS=50

# optional | mandatory | none
ACCOUNT_EMAIL_VERIFICATION=optional

# --- Email -----------------------------------------------------------------------------
# Locally emails are printed in the console. Server: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=BusinessBuilder - Devnixplus <no-reply@devnixplus.com>
# Logo at the top of every email (PNG; Gmail does not show SVG). Keep it on the live site: mail apps can't load localhost
EMAIL_LOGO_URL=https://www.businessbuilder.devnixplus.com/static/img/email-logo-businessbuilder.png
# Brand name in email subjects, text and sign-off (the footer keeps COMPANY_NAME)
EMAIL_BRAND_NAME=BusinessBuilder - Devnixplus

# --- Razorpay --------------------------------------------------------------------------
# Leave the keys empty to use the Demo Payment Simulator. rzp_test_... first, rzp_live_... after activation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Webhooks -> URL <APP_URL>/billing/webhook/ (payment.captured, payment.failed, refund.processed)
RAZORPAY_WEBHOOK_SECRET=
# True = Demo Payment Simulator. False on the server.
DEMO_PAYMENTS=True

# --- Invoices --------------------------------------------------------------------------
COMPANY_NAME=Devnixplus
COMPANY_ADDRESS=Your registered address, City, State PIN
COMPANY_EMAIL=info@devnixplus.com
COMPANY_PHONE=+91 91835 59191
INVOICE_PREFIX=DNX
# GST lines appear on invoices only when GST_ENABLED=True and COMPANY_GSTIN is set
GST_ENABLED=False
COMPANY_GSTIN=
COMPANY_STATE=

# --- SMS OTP and WhatsApp --------------------------------------------------------------
# True = new owners confirm their mobile number with an SMS code (needs SMS_PROVIDER=msg91 + DLT approval).
# False = they type their number but skip the code; only the email is confirmed.
PHONE_OTP_REQUIRED=True
# mock = the OTP is shown on screen | msg91
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# mock = messages are only logged | cloud = WhatsApp Cloud API
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- Local demo logins (manage.py seed_demo, only when DEBUG=True) ----------------------
DEMO_LOGIN_PASSWORD=Demo@12345
