# =============================================================================
# Copy to .env and fill in. .env is never committed (see .gitignore).
# One file for the static demo tools and the Django site builder (builder/).
# Keep comments on their own lines: "KEY=value # note" would put the note in the value.
# =============================================================================

# --- Static demos (unchanged) --------------------------------------------------
# docker compose: http://localhost:<DOCKER_PORT>/
DOCKER_PORT=8080
# python new_demo.py --serve <slug> (pick another port than Django's runserver 8000)
SERVE_PORT=8001

# --- Django core ---------------------------------------------------------------
# False on the server
DEBUG=True
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
# server: app.devnixplus.com
ALLOWED_HOSTS=127.0.0.1,localhost
# server: https://app.devnixplus.com
CSRF_TRUSTED_ORIGINS=
# Not set = SQLite in builder/db.sqlite3. Production (PostgreSQL):
# DATABASE_URL=postgres://devnix:PASSWORD@127.0.0.1:5432/devnix
# Several Gunicorn workers share rate limits through a file cache on the server:
# CACHE_URL=filecache:///var/tmp/devnix-cache
CACHE_URL=locmemcache://
# True on the server (HTTPS only cookies)
SECURE_COOKIES=False
# Nginx already redirects http -> https
SECURE_SSL_REDIRECT=False

# --- URLs and folders ------------------------------------------------------------
# server: https://app.devnixplus.com
APP_URL=http://127.0.0.1:8000
# path      -> <DEMO_BASE_URL>/<slug>/   (how the demos are served today)
# subdomain -> <DEMO_SCHEME>://<slug>.<DEMO_DOMAIN>/
DEMO_URL_STYLE=path
# server: https://demo.devnixplus.com
DEMO_BASE_URL=http://127.0.0.1:8000/sites
DEMO_DOMAIN=demo.devnixplus.com
DEMO_SCHEME=https
# Where Nginx serves the sites from. Default: var/sites in the repo. Server: /var/www/demos
# SITES_ROOT=/var/www/demos
# Uploaded photos (default var/media). Server: /var/www/devnix-media
# MEDIA_ROOT=/var/www/devnix-media
# collectstatic target (default var/static). Server: /var/www/devnix-static
# STATIC_ROOT=/var/www/devnix-static
# Default var/logs. Server: /var/log/devnix
# LOG_DIR=/var/log/devnix
# Bump (v2, v3…) after changing template/, then run sync_shared and republish_all
SHARED_VERSION=v1
# Django serves /sites/ and /_shared/ itself (default = DEBUG). Never on the server.
# SERVE_SITES=True

# --- Login with Google (optional; the button only shows when set) -------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorised redirect URI: <APP_URL>/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# optional | mandatory | none
ACCOUNT_EMAIL_VERIFICATION=optional

# --- Email ---------------------------------------------------------------------------
# Server: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Devnixplus <no-reply@devnixplus.com>

# --- Razorpay ------------------------------------------------------------------------
# Leave the keys empty to use the Demo Payment Simulator. rzp_test_… first, rzp_live_… after activation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Webhooks -> URL <APP_URL>/billing/webhook/ (events: payment.captured, payment.failed, refund.processed)
RAZORPAY_WEBHOOK_SECRET=
# False on the server
DEMO_PAYMENTS=True

# --- Invoices ------------------------------------------------------------------------
COMPANY_NAME=Devnixplus
COMPANY_ADDRESS=Your registered address, City, State PIN
COMPANY_EMAIL=hello@devnixplus.com
COMPANY_PHONE=+91 91835 59191
INVOICE_PREFIX=DNX
# GST lines appear on invoices only when GST_ENABLED=True and COMPANY_GSTIN is set
GST_ENABLED=False
COMPANY_GSTIN=
COMPANY_STATE=

# --- SMS OTP and WhatsApp ------------------------------------------------------------
# mock = the OTP is shown on screen | msg91
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# mock = messages are only logged | cloud = WhatsApp Cloud API
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
