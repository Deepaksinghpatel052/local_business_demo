# systemd unit for the Django site builder (Gunicorn on a unix socket for Nginx).
#   sudo cp deploy/devnix-gunicorn.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now devnix-gunicorn
#   sudo systemctl restart devnix-gunicorn      # after every deploy
#   journalctl -u devnix-gunicorn -f            # logs
[Unit]
Description=Devnixplus site builder (Gunicorn)
After=network.target postgresql.service

[Service]
User=devnix
Group=www-data
# settings come from /srv/local_business_demo/.env (read by config/settings.py)
WorkingDirectory=/srv/local_business_demo/builder
RuntimeDirectory=devnix
RuntimeDirectoryMode=0755
UMask=0002
ExecStart=/srv/local_business_demo/venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/devnix/gunicorn.sock \
    --workers 3 --timeout 60 \
    --access-logfile /var/log/devnix/gunicorn-access.log \
    --error-logfile /var/log/devnix/gunicorn-error.log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
