# =============================================================================
# A customer's own domain for a hosted site. /manage/projects/<id>/ generates this block
# (with the right domain and slug) and the certbot commands; this file is the reference copy.
# Replace CUSTOMER_DOMAIN and SLUG:
#   sudo cp nginx-customer-domain.conf.template /etc/nginx/sites-available/CUSTOMER_DOMAIN.conf
# Steps: DNS A @ + www -> SERVER_IP, certbot (see docs/ADMIN_GUIDE.md), enable, nginx -t, reload.
# =============================================================================
server {
    listen 80;
    listen [::]:80;
    server_name CUSTOMER_DOMAIN www.CUSTOMER_DOMAIN;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://CUSTOMER_DOMAIN$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name CUSTOMER_DOMAIN www.CUSTOMER_DOMAIN;
    ssl_certificate     /etc/letsencrypt/live/CUSTOMER_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/CUSTOMER_DOMAIN/privkey.pem;
    if ($host = www.CUSTOMER_DOMAIN) { return 301 https://CUSTOMER_DOMAIN$request_uri; }

    root /var/www/demos/SLUG;
    index index.html;
    location /_shared/ { alias /var/www/demos/_shared/; expires 30d; }
    location ~ /\. { deny all; }
    location = /data.js { expires -1; }
    location ~* \.(?:jpg|jpeg|png|webp|gif|svg|ico|css|js|woff2?)$ { expires 7d; }
    location / { try_files $uri $uri/ =404; }
    gzip on;
    gzip_types text/css application/javascript text/javascript image/svg+xml;
}
